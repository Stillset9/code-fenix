{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json", ".firebaserc", "firestore.rules", "**/.*", "**/node_modules/**",
      "referencias/**", "screenshots/**", "tools/**", "tests_puppeteer.js", "tests_mobile.js", "*.md"
    ],
    "headers": [
      { "source": "sw.js", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] },
      { "source": "**/*.@(js|webmanifest)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=300" } ] },
      { "source": "icons/**", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
