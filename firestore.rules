rules_version = '2';
// CODE FENIX — cada persona solo puede leer y escribir su propia partida: /saves/{uid}
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'name', 'game', 'v'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 500000
        && request.resource.data.updatedAt is number;
    }
    // Todo lo demás está cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
